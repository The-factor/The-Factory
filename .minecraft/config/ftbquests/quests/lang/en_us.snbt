	quest.19F421C461D2D211.title: "Iron Ingots"
	quest.1A1C968D5D85C8DA.quest_desc: ["16384 Bytes"]
	quest.1A1C968D5D85C8DA.quest_subtitle: "Efficient Storage Solutions"
	quest.1F5E8A486D04D838.quest_desc: ["Can be used in conjuncture with Either the Mechanical Press or the Mechanical Mixer for both fluid and item recipes."]
	quest.1F5E8A486D04D838.quest_subtitle: "Based"
	quest.1F78F951B004D942.quest_desc: ["A shaft is used to transfer rotational energy, they can be place lineraly both vertically and horizontally."]
	quest.1F78F951B004D942.quest_subtitle: "No Not That Kind"
	quest.20777B1F99C236DA.quest_desc: ["Logic Processors are very important for AE2 automation."]
	quest.20777B1F99C236DA.quest_subtitle: "Faulty Logic"
